@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>Iniciar sesión</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
    <div class="mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input type="email" asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="Recuerdame" class="form-check-input" />
        <label asp-for="Recuerdame" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Entrar</button>
</form>

<p class="mt-3">¿Eres nutriólogo y no tienes cuenta? <a asp-action="Registro">Regístrate</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
