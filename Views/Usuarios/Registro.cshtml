@model RegistroViewModel
@{
    ViewData["Title"] = "Registro";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1>Registro de nutriólogo</h1>
        <h5 class="text-muted mb-4">
            Crea tu cuenta para gestionar a tus pacientes. Los pacientes no se registran aquí:
            tú los das de alta desde tu panel.
        </h5>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <form asp-action="Registro">
            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" autocomplete="name" />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input type="email" asp-for="Correo" class="form-control" autocomplete="username" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="ConfirmarPassword" class="form-label"></label>
                    <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
                </div>
            </div>
            <div class="form-text mb-3">
                Mínimo 6 caracteres, con mayúscula, minúscula, número y un carácter especial.
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="CedulaProfesional" class="form-label"></label>
                    <input asp-for="CedulaProfesional" class="form-control" />
                    <span asp-validation-for="CedulaProfesional" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Especialidad" class="form-label"></label>
                    <input asp-for="Especialidad" class="form-control" />
                    <span asp-validation-for="Especialidad" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
        </form>

        <p class="mt-3 text-center">
            ¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
