@model RegistroViewModel
@{
    ViewData["Title"] = "Registro";
}

<h1>Registro de nutriólogo</h1>

<h5>Los pacientes no se registran aquí: los da de alta su nutriólogo.</h5>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Registro">
    <div class="mb-3">
        <label asp-for="NombreCompleto" class="form-label"></label>
        <input asp-for="NombreCompleto" class="form-control" />
        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input type="email" asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <div class="form-text">Mínimo 6 caracteres, con mayúscula, minúscula, número y un carácter especial.</div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CedulaProfesional" class="form-label"></label>
        <input asp-for="CedulaProfesional" class="form-control" />
        <span asp-validation-for="CedulaProfesional" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrarme</button>
</form>

<p class="mt-3">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
